+import sqlite3
+
+
+def get_user(conn, username):
+    cursor = conn.cursor()
+    cursor.execute(f"SELECT id, email FROM users WHERE name = '{username}'")
+    return cursor.fetchone()
+
+
+def count_users(conn):
+    cursor = conn.cursor()
+    cursor.execute("SELECT COUNT(*) FROM users")
+    return cursor.fetchone()[0]
