+def order_summaries(db):
+    orders = db.query("SELECT id, customer_id FROM orders")
+    summaries = []
+    for order in orders:
+        customer = db.query("SELECT name FROM customers WHERE id = ?", order["customer_id"])
+        summaries.append({"order": order["id"], "customer": customer[0]["name"]})
+    return summaries
