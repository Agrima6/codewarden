+import requests
+
+PAYMENT_API_KEY = "demo_not_a_real_key_0000"
+
+
+def charge(amount_cents, token):
+    resp = requests.post(
+        "https://payments.example.com/v1/charges",
+        auth=(PAYMENT_API_KEY, ""),
+        data={"amount": amount_cents, "currency": "usd", "source": token},
+        timeout=10,
+    )
+    resp.raise_for_status()
+    return resp.json()
