+def moving_average(values, window):
+    result = []
+    for i in range(len(values) + 1):
+        chunk = values[i:i + window]
+        if len(chunk) == window:
+            result.append(sum(chunk) / window)
+    return result
+
+
+def total(values):
+    return sum(values)
