+import os
+
+from app.auth import require_login
+
+AVATAR_DIR = "/srv/avatars"
+
+
+def save_avatar(request, filename, data):
+    require_login(request)
+    target = os.path.join(AVATAR_DIR, filename)
+    with open(target, "wb") as fh:
+        fh.write(data)
+    return target
